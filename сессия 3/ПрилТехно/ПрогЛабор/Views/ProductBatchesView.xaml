<UserControl x:Class="ПрогЛабор.Views.ProductBatchesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                     Width="200" Margin="0,0,10,0" Height="30" />
            <Button Content="🔍 Поиск" Command="{Binding LoadBatchesCommand}" Margin="0,0,10,0" Padding="10,5"/>
            <Button Content="🔄 Обновить" Command="{Binding RefreshCommand}" Padding="10,5"/>
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Batches}" SelectedItem="{Binding SelectedBatch}"
                  AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер партии" Binding="{Binding BatchNumber}" Width="120"/>
                <DataGridTextColumn Header="Продукт" Binding="{Binding ProductName}" Width="200"/>
                <DataGridTextColumn Header="План, кг" Binding="{Binding PlannedQuantityKg}" Width="100"/>
                <DataGridTextColumn Header="Факт, кг" Binding="{Binding ActualQuantityKg}" Width="100"/>
                <DataGridTextColumn Header="Дата запуска" Binding="{Binding StartTime, StringFormat='dd.MM.yyyy'}" Width="120"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                <DataGridTextColumn Header="Лаб. решение" Binding="{Binding LabDecision}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="➕ Новое испытание" Command="{Binding StartTestCommand}" 
                    Margin="0,0,10,0" Padding="10,5"/>
            <Button Content="📋 Просмотр испытания" Command="{Binding ViewTestCommand}" 
                    Margin="0,0,10,0" Padding="10,5"/>
            <Button Content="⚖️ Принять решение" Command="{Binding MakeDecisionCommand}" 
                    Padding="10,5"/>
        </StackPanel>
    </Grid>
</UserControl>