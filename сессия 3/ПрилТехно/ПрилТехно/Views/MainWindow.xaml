<Window x:Class="ПрилТехно.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ПрилТехно"
        xmlns:helpers="clr-namespace:ПрилТехно.Helpers"
        mc:Ignorable="d"
  Title="Технолог - Система управления производством" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <helpers:Base64ToImageConverter x:Key="Base64ToImageConverter"/>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#34495E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3D566E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левое меню -->
        <Border Grid.Column="0" Background="#2C3E50">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <!-- Фото пользователя (заглушка) -->
                    <Border CornerRadius="50" Width="80" Height="80" Background="LightGray" Margin="0,20,0,10" HorizontalAlignment="Center">
                        <Image Source="{Binding UserPhotoBase64, Converter={StaticResource Base64ToImageConverter}}" 
                               Width="80" Height="80" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="{Binding UserFullName}" Foreground="White" HorizontalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Text="{Binding UserRole}" Foreground="#BDC3C7" HorizontalAlignment="Center" FontSize="12" Margin="0,0,0,20"/>

                    <Button Content="Главная" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" Style="{StaticResource MenuButtonStyle}" Margin="0,5"/>
                    <Button Content="Продукция" Command="{Binding NavigateCommand}" CommandParameter="Products" Style="{StaticResource MenuButtonStyle}" Margin="0,5"/>
                    <Button Content="Рецептуры" Command="{Binding NavigateCommand}" CommandParameter="Recipes" Style="{StaticResource MenuButtonStyle}" Margin="0,5"/>
                    <Button Content="Техкарты" Command="{Binding NavigateCommand}" CommandParameter="TechCards" Style="{StaticResource MenuButtonStyle}" Margin="0,5"/>
                    <Button Content="Заказы" Command="{Binding NavigateCommand}" CommandParameter="Orders" Style="{StaticResource MenuButtonStyle}" Margin="0,5"/>
                    <Button Content="Партии" Command="{Binding NavigateCommand}" CommandParameter="Batches" Style="{StaticResource MenuButtonStyle}" Margin="0,5"/>
                    <Button Content="Экструдер" Command="{Binding NavigateCommand}" CommandParameter="Extruder" Style="{StaticResource MenuButtonStyle}" Margin="0,5"/>
                    <Button Content="События" Command="{Binding NavigateCommand}" CommandParameter="Events" Style="{StaticResource MenuButtonStyle}" Margin="0,5"/>
                    <Button Content="Отчёты" Command="{Binding NavigateCommand}" CommandParameter="Reports" Style="{StaticResource MenuButtonStyle}" Margin="0,5"/>

                    <Button Content="Выход" Command="{Binding LogoutCommand}" Style="{StaticResource MenuButtonStyle}" Margin="0,30,0,0" Background="#C0392B"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Центральная область -->
        <ContentControl x:Name="MainContent" Grid.Column="1" Margin="20"/>
    </Grid>
</Window>