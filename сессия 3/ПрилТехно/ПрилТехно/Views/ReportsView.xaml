<UserControl x:Class="ПрилТехно.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель – список отчётов -->
        <Border Grid.Column="0" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="1" CornerRadius="5">
            <ListBox x:Name="ReportListBox" SelectedItem="{Binding SelectedReport}" Margin="5">
                <ListBoxItem Content="Отчёт по партиям за период"/>
                <ListBoxItem Content="Отчёт по отклонениям"/>
                <ListBoxItem Content="Отчёт по использованию рецептур"/>
                <ListBoxItem Content="Отчёт по событиям экструдера"/>
                <ListBoxItem Content="Отчёт по лабораторным блокировкам"/>
            </ListBox>
        </Border>

        <!-- Правая область – параметры и результат -->
        <StackPanel Grid.Column="1" Margin="10">
            <GroupBox Header="Параметры отчёта" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" Margin="10">
                    <TextBlock Text="Период:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <DatePicker SelectedDate="{Binding StartDate}" Width="120" Margin="0,0,10,0"/>
                    <TextBlock Text="—" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <DatePicker SelectedDate="{Binding EndDate}" Width="120" Margin="0,0,20,0"/>
                    <Button Content="Сформировать" Command="{Binding GenerateReportCommand}" 
                            Width="100" Padding="8,3" IsEnabled="{Binding IsNotLoading}"/>
                    <Button Content="Экспорт в Excel" Command="{Binding ExportCommand}" 
                            Width="120" Margin="10,0,0,0" Padding="8,3" IsEnabled="{Binding CanExport}"/>
                </StackPanel>
            </GroupBox>

            <ProgressBar IsIndeterminate="True" Height="5">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <DataGrid x:Name="ReportDataGrid" ItemsSource="{Binding ReportData}" 
                          AutoGenerateColumns="True" CanUserAddRows="False" CanUserDeleteRows="False"
                          IsReadOnly="True" Margin="0,10,0,0"/>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</UserControl>