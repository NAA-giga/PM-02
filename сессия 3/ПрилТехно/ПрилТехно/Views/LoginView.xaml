<Window x:Class="ПрилТехно.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Вход в систему" 
        Height="450" Width="550"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Авторизация" FontSize="24" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- Логин -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="Логин:" Width="100" VerticalAlignment="Center" FontSize="14"/>
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                     Width="300" Margin="10,0" Height="30" FontSize="14"/>
        </StackPanel>

        <!-- Пароль -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="Пароль:" Width="100" VerticalAlignment="Center" FontSize="14"/>
            <PasswordBox x:Name="PasswordBox" Width="300" Margin="10,0" Height="30" FontSize="14"
                         PasswordChanged="PasswordBox_PasswordChanged"/>
        </StackPanel>

        <!-- Капча: изображение + кнопка обновить -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,20,0,10">
            <TextBlock Text="Капча:" Width="100" VerticalAlignment="Center" FontSize="14"/>
            <Image Source="{Binding CaptchaImage}" Width="200" Height="60" Margin="10,0" Stretch="Fill"/>
            <Button Content="🔄 Обновить" Command="{Binding GenerateNewCaptchaCommand}" 
                    Margin="10,0" Width="100" Height="30" Cursor="Hand"/>
        </StackPanel>

        <!-- Поле ввода капчи -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="Введите код:" Width="100" VerticalAlignment="Center" FontSize="14"/>
            <TextBox Text="{Binding CaptchaInput, UpdateSourceTrigger=PropertyChanged}" 
                     Width="300" Margin="10,0" Height="30" FontSize="14"/>
        </StackPanel>

        <!-- Кнопка входа и сообщение об ошибке -->
        <StackPanel Grid.Row="5" Margin="0,20">
            <Button Content="Войти" Command="{Binding LoginCommand}" 
                    HorizontalAlignment="Center" Width="150" Height="40" FontSize="14"
                    Cursor="Hand" Background="#4CAF50" Foreground="White"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" Margin="0,10" 
                       HorizontalAlignment="Center" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid></Window>