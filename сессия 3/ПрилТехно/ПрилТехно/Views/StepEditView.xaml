<Window x:Class="ПрилТехно.Views.StepEditView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование шага" Height="500" Width="500"
        WindowStartupLocation="CenterOwner">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <GroupBox Header="Основное">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Название шага:" Grid.Row="0" Grid.Column="0"/>
                    <TextBox Text="{Binding Step.StepName}" Grid.Row="0" Grid.Column="1"/>

                    <TextBlock Text="Тип:" Grid.Row="1" Grid.Column="0"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" 
                              ItemsSource="{Binding StepTypes}" SelectedItem="{Binding Step.StepType}" IsEditable="True"/>

                    <TextBlock Text="Оборудование:" Grid.Row="2" Grid.Column="0"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" 
                              ItemsSource="{Binding EquipmentList}" SelectedItem="{Binding SelectedEquipment}"
                              DisplayMemberPath="Name"/>

                    <CheckBox Grid.Row="3" Grid.Column="1" Content="Обязательный шаг" IsChecked="{Binding Step.IsMandatory}"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="Плановые параметры">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Температура, °C:" Grid.Row="0" Grid.Column="0"/>
                    <TextBox Text="{Binding Step.PlannedTempC}" Grid.Row="0" Grid.Column="1"/>

                    <TextBlock Text="Давление, бар:" Grid.Row="1" Grid.Column="0"/>
                    <TextBox Text="{Binding Step.PlannedPressureBar}" Grid.Row="1" Grid.Column="1"/>

                    <TextBlock Text="Время, мин:" Grid.Row="2" Grid.Column="0"/>
                    <TextBox Text="{Binding Step.PlannedDurationMin}" Grid.Row="2" Grid.Column="1"/>

                    <TextBlock Text="Скорость, об/мин:" Grid.Row="3" Grid.Column="0"/>
                    <TextBox Text="{Binding Step.PlannedSpeedRpm}" Grid.Row="3" Grid.Column="1"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="Допуски">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Температура -:" Grid.Row="0" Grid.Column="0"/>
                    <TextBox Text="{Binding Step.TempToleranceMin}" Grid.Row="0" Grid.Column="1"/>
                    <TextBlock Text="Температура +:" Grid.Row="0" Grid.Column="2"/>
                    <TextBox Text="{Binding Step.TempToleranceMax}" Grid.Row="0" Grid.Column="3"/>

                    <TextBlock Text="Давление -:" Grid.Row="1" Grid.Column="0"/>
                    <TextBox Text="{Binding Step.PressureToleranceMin}" Grid.Row="1" Grid.Column="1"/>
                    <TextBlock Text="Давление +:" Grid.Row="1" Grid.Column="2"/>
                    <TextBox Text="{Binding Step.PressureToleranceMax}" Grid.Row="1" Grid.Column="3"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="Инструкция">
                <TextBox Text="{Binding Step.Instruction}" TextWrapping="Wrap" MinHeight="80" AcceptsReturn="True"/>
            </GroupBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20">
                <Button Content="Сохранить" Command="{Binding SaveCommand}" Width="80" Margin="0,0,10,0"/>
                <Button Content="Отмена" Command="{Binding CancelCommand}" Width="80"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>