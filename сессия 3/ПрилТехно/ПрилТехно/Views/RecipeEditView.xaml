<Window x:Class="ПрилТехно.Views.RecipeEditView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование рецептуры" Height="600" Width="800"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Основные поля рецептуры -->
        <GroupBox Header="Общие сведения" Grid.Row="0" Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Продукт:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="0" Grid.Column="1" 
                          ItemsSource="{Binding Products}" 
                          SelectedItem="{Binding SelectedProduct}"
                          DisplayMemberPath="Name"
                          IsEnabled="{Binding IsProductSelectable}"
                          Margin="5,0"/>

                <TextBlock Text="Название рецептуры:" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding RecipeName}" Margin="5,0"/>

                <TextBlock Text="Версия:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RecipeVersion}" Margin="5,0" VerticalAlignment="Center"/>
            </Grid>
        </GroupBox>

        <!-- Таблица компонентов -->
        <GroupBox Header="Компоненты рецептуры" Grid.Row="1" Grid.RowSpan="2" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
                    <Button Content="➕ Добавить" Command="{Binding AddComponentCommand}" Margin="0,0,10,0" Padding="8,3"/>
                    <Button Content="✏️ Редактировать" Command="{Binding EditComponentCommand}" 
                            CommandParameter="{Binding SelectedComponent}" Margin="0,0,10,0" Padding="8,3"/>
                    <Button Content="🗑️ Удалить" Command="{Binding RemoveComponentCommand}" 
                            CommandParameter="{Binding SelectedComponent}" Margin="0,0,10,0" Padding="8,3"/>
                </StackPanel>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Components}" 
                          SelectedItem="{Binding SelectedComponent}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№ п/п" Binding="{Binding LoadOrder}" Width="60"/>
                        <DataGridTextColumn Header="Сырьё" Binding="{Binding RawMaterialName}" Width="200"/>
                        <DataGridTextColumn Header="Доля, %" Binding="{Binding Percentage}" Width="80"/>
                        <DataGridTextColumn Header="Допуск -" Binding="{Binding ToleranceMin}" Width="80"/>
                        <DataGridTextColumn Header="Допуск +" Binding="{Binding ToleranceMax}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <!-- Кнопки действий -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10">
            <Button Content="Сохранить" Command="{Binding SaveCommand}" Width="100" Margin="0,0,10,0" Padding="8,3"/>
            <Button Content="Отмена" Command="{Binding CancelCommand}" Width="100" Padding="8,3"/>
        </StackPanel>
    </Grid>
</Window>