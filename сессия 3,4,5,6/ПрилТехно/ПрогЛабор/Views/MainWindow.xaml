<Window x:Class="ПрогЛабор.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:ПрогЛабор.ViewModels"
        Title="Лаборатория - Система контроля качества" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2C3E50"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#34495E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левое меню -->
        <Border Grid.Column="0" Background="#1A252F">
            <StackPanel Margin="10">
                <TextBlock Text="ЛАБОРАТОРИЯ" FontSize="18" FontWeight="Bold" Foreground="White" 
                           HorizontalAlignment="Center" Margin="0,20,0,20"/>
                <Button Content="Сырьё" Command="{Binding NavigateCommand}" CommandParameter="RawMaterial"
                        Style="{StaticResource MenuButtonStyle}" Margin="0,5"/>
                <Button Content="Готовая продукция" Command="{Binding NavigateCommand}" CommandParameter="Product"
                        Style="{StaticResource MenuButtonStyle}" Margin="0,5"/>
                <Button Content="Выход" Command="{Binding LogoutCommand}" 
                        Style="{StaticResource MenuButtonStyle}" Margin="0,30,0,0" Background="#C0392B"/>
            </StackPanel>
        </Border>

        <!-- Центральная область -->
        <ContentControl x:Name="MainContent" Grid.Column="1" Margin="20"/>
    </Grid>
</Window>