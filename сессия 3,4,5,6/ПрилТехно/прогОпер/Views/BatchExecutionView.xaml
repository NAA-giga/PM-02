<UserControl x:Class="прогОпер.Views.BatchExecutionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель с информацией о партии -->
        <Border Grid.Row="0" Background="LightGray" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Партия: " FontWeight="Bold"/>
                <TextBlock Text="{Binding Batch.BatchNumber}" Margin="0,0,20,0"/>
                <TextBlock Text="Статус: " FontWeight="Bold"/>
                <TextBlock Text="{Binding Batch.Status}" Margin="0,0,20,0"/>
                <Button Content="← Назад" Command="{Binding GoBackCommand}" HorizontalAlignment="Right" Width="80"/>
            </StackPanel>
        </Border>

        <!-- Основная область: список шагов слева, детали шага справа -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Список шагов -->
            <ListBox Grid.Column="0" ItemsSource="{Binding Steps}" 
                     SelectedItem="{Binding SelectedStep}"
                     DisplayMemberPath="StepName"
                     Margin="0,0,10,0">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="completed">
                                <Setter Property="Background" Value="LightGreen"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="running">
                                <Setter Property="Background" Value="LightBlue"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="pending">
                                <Setter Property="Background" Value="LightGray"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- Детали выбранного шага (пока просто заглушка) -->
            <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Padding="10">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedStep.StepName}" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding SelectedStep.Instruction}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock Text="Плановые параметры:" FontWeight="Bold"/>
                    <TextBlock Text="{Binding SelectedStep.PlannedTempC, StringFormat='Температура: {0} °C'}" Margin="10,2"/>
                    <TextBlock Text="{Binding SelectedStep.PlannedPressureBar, StringFormat='Давление: {0} бар'}" Margin="10,2"/>
                    <TextBlock Text="{Binding SelectedStep.PlannedDurationMin, StringFormat='Длительность: {0} мин'}" Margin="10,2"/>
                    <TextBlock Text="{Binding SelectedStep.PlannedSpeedRpm, StringFormat='Скорость: {0} об/мин'}" Margin="10,2"/>

                    <Separator Margin="0,10"/>

                    <TextBlock Text="Фактические параметры (будут доступны для ввода в следующем спринте)" FontStyle="Italic"/>
                    <!-- Поля ввода появятся в Спринте 3 -->
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>