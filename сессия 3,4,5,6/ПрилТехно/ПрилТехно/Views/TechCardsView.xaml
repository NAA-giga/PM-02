<UserControl x:Class="ПрилТехно.Views.TechCardsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#F5F5F5" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="➕ Создать" Command="{Binding CreateTechCardCommand}" Margin="0,0,10,0" Padding="10,5"/>
                <Button Content="✏️ Редактировать" Command="{Binding EditTechCardCommand}" CommandParameter="{Binding SelectedItem, ElementName=TechCardsGrid}" Margin="0,0,10,0" Padding="10,5"/>
                <Button Content="✅ Утвердить" Command="{Binding ApproveTechCardCommand}" CommandParameter="{Binding SelectedItem, ElementName=TechCardsGrid}" Margin="0,0,10,0" Padding="10,5"/>
                <Button Content="📦 Архивировать" Command="{Binding ArchiveTechCardCommand}" CommandParameter="{Binding SelectedItem, ElementName=TechCardsGrid}" Margin="0,0,10,0" Padding="10,5"/>
                <Button Content="🔄 Обновить" Command="{Binding RefreshCommand}" Padding="10,5"/>
            </StackPanel>
        </Border>
        <DataGrid x:Name="TechCardsGrid" Grid.Row="1" ItemsSource="{Binding TechCards}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Продукт" Binding="{Binding ProductName}" Width="150"/>
                <DataGridTextColumn Header="Версия" Binding="{Binding Version}" Width="80"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="200"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                <DataGridTextColumn Header="Создана" Binding="{Binding CreatedAt, StringFormat='dd.MM.yyyy'}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>