<UserControl x:Class="ПрилТехно.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Главная панель управления" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
            <TextBlock Text="{Binding FullName, StringFormat='Добро пожаловать, {0}'}" FontSize="16" Margin="0,0,0,10"/>
            <TextBlock Text="{Binding Role, StringFormat='Ваша роль: {0}'}" Margin="0,0,0,30"/>
            <Border Background="#F0F0F0" Padding="20" CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="Ключевые показатели" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="5">
                            <TextBlock Text="Активных продуктов:" />
                            <TextBlock Text="{Binding ActiveProductsCount}" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5">
                            <TextBlock Text="Партий в работе:" />
                            <TextBlock Text="{Binding ActiveBatchesCount}" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>